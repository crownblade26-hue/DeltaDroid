name: Build APK
on:
  workflow_dispatch:
  push:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: unzip -o DeltaDroid.zip -d project
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - name: Install Android SDK parts
        run: |
          SDKM=$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager
          yes | $SDKM --licenses > /dev/null || true
          $SDKM "platforms;android-34" "build-tools;34.0.0" "cmake;3.22.1" "ndk;26.3.11579264"
      - name: Download libretro cores
        working-directory: project
        run: |
          mkdir -p app/src/main/jniLibs/arm64-v8a
          for pair in mgba:mgba gambatte:gambatte fceumm:fceumm snes9x:snes9x genesis_plus_gx:gpgx; do
            src=${pair%%:*}; dst=${pair##*:}
            curl -fL https://buildbot.libretro.com/nightly/android/latest/arm64-v8a/${src}_libretro_android.so.zip -o $src.zip
            unzip -o $src.zip
            mv ${src}_libretro_android.so app/src/main/jniLibs/arm64-v8a/libcore_$dst.so
          done
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "8.7"
      - name: Build
        working-directory: project
        run: gradle assembleDebug --no-daemon
      - uses: actions/upload-artifact@v4
        with:
          name: DeltaDroid-apk
          path: project/app/build/outputs/apk/debug/*.apk
